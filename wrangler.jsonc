// Cloudflare Workers configuration for the public crowbo.ai website.
// Static files only: everything in ./site is served as-is and no Worker code runs.
// ./site is generated by `npm run build` in design/decision-studio (Decision Studio);
// its public/ folder supplies _headers, 404.html and the licence texts. Edit the
// source there, rebuild, and commit the regenerated site/ together with the change.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker the Cloudflare GitHub integration deploys to.
  "name": "crowbo",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },
  // Cloudflare creates the DNS record and certificate for this hostname on deploy.
  "routes": [
    { "pattern": "crowbo.ai", "custom_domain": true }
  ],
  // Branch preview URLs on *.workers.dev; the production site stays on crowbo.ai.
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview`, the non-production branch deploy command in
  // Workers Builds. Empty: the static site has no bindings to override. Ignored by
  // `wrangler deploy`, so the production deploy to crowbo.ai is unchanged.
  "previews": {}
}
