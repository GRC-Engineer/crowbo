// Cloudflare Workers configuration for the Crowbo decision API (separate from the crowbo.ai site).
// Each tenant's system of record is one SQLite-backed Durable Object, created in the EU
// jurisdiction by the Worker (src/worker.ts). Turbopuffer holds rebuildable search chunks only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crowbo-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "durable_objects": { "bindings": [{ "name": "TENANT", "class_name": "TenantStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TenantStore"] }],
  // Poll registered Slack syncs; each sync decides for itself whether it is due.
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": { "AI_GATEWAY": "default", "ALLOW_SYNTHETIC_GATES": "false" },
  // Secrets (never in this file): CROWBO_OPERATORS, CLOUDFLARE_API_TOKEN, TURBOPUFFER_API_KEY,
  // SLACK_API_TOKEN, and the var CLOUDFLARE_ACCOUNT_ID.
  "env": {
    "staging": {
      "name": "crowbo-api-staging",
      "workers_dev": true,
      "vars": { "AI_GATEWAY": "default", "ALLOW_SYNTHETIC_GATES": "true" },
      "durable_objects": { "bindings": [{ "name": "TENANT", "class_name": "TenantStore" }] },
      // OAuth clients and grants for Claude connectors (src/app/oauth.ts). Staging only: without
      // this binding the Worker accepts operator bearer tokens alone. Wrangler creates the
      // namespace on first deploy.
      "kv_namespaces": [{ "binding": "OAUTH_KV" }],
      "triggers": { "crons": [] }
    }
  }
}
